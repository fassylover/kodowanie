  width: 300px;
  object-fit: cover;
  height: 500px;
  position: relative;
  }
  .poison-img:after {
  background: linear-gradient(45deg, var(--accentoa), transparent);
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  top: 0;
  mix-blend-mode: hue;
  }
  .poison-nom {
