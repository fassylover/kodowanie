  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  height: 150px;
  }
  .poison-timg, .poison-timg img {
  height: 115px;
  width: 500px;
  object-fit: cover;
  position: absolute;
  opacity:0.8;
  }
  .poison-timg:after {
  background: var(--grad);
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  top: 0;
  mix-blend-mode: multiply;
  }
  .poison-dts {
  width: 125px;
  padding: 10px;
  border-right: 10px solid var(--accentob);
  background: var(--blanco);
  position: relative;
  margin: 25px 25px 0 0;
  height: fit-content;
  }
  .poison-dts span {
  display: block;
  font-size: 10px;
  font-family: var(--letra);
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  opacity: 0.85;
  border-radius: 5px;
  }
  .poison-trams {
  margin: 15px;
  overflow: auto;
  height: 470px;
  padding-left: 7px;
  direction: rtl;
  }
  .poison-int {
  max-height: 250px;
  padding: 15px;
  border-right: 2px solid var(--accentoa);
  margin-bottom: 8px;
  overflow: auto;
  background:var(--eee);
  }
  .poison-int:nth-of-type(odd) {
  border-right: 2px solid var(--accentob);
  }
  .poison-int:last-of-type {
  margin-bottom: 0;
  }
  .poison-int p {
  direction: ltr;
  line-height: 1.15rem;
  font-size: 13px;
  font-family: arial, sans-serif;
  text-align: justify;
  }
  .poison-int span.h {
  font-family: var(--letrab);
  font-size: 30px;
  border: 1px solid var(--accentob);
  margin:0 5px;
  line-height: 34px;
  padding: 0 15px 0 10px;
  font-style: italic;
  float:left;
  }
  .poison-int span.sub {
  font-family: var(--letra);
  margin: 5px;
  -webkit-text-stroke: 1px var(--accentoa);
  font-weight: 900;
  color: transparent;
  text-transform: uppercase;
  font-size: 21px;
  display: block;
  }
  .poison-int strong{
  color: var(--accentoa);
  }
  .poison-int::-webkit-scrollbar-thumb {
  background: var(--grad)!important;
  }
/*shadow*/
