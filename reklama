/*in blood*/
.inblood{
  --blancorgb:255,255,255;
  --negrorgb:0,0,0;
  --eee:#eee;
  --ddd:#ddd;
  --accentoa: #c75948;
  --accentob: #76302c;
  --letra: "Roboto";
  --letrab: "Jost";
  --borde:1px solid var(--accentob);
  --bk:url(https://i.ibb.co/TB44Lft/mountain.jpg);
  --grad:linear-gradient(90deg,var(--accentoa), var(--accentob));
  --shws:1px 1px 2px rgba(var(--negrorgb), 0.1), -1px -1px 2px rgba(var(--negrorgb), 0.1), -1px 1px 2px rgba(var(--negrorgb), 0.1), 1px -1px 2px rgba(var(--negrorgb), 0.1);
  --shwsb:1px 1px 1px rgba(var(--negrorgb), 0.1), -1px -1px 1px rgba(var(--negrorgb), 0.1), -1px 1px 1px rgba(var(--negrorgb), 0.1), 1px -1px 1px rgba(var(--negrorgb), 0.1);
  }
  .inblood {
  width: 475px;
  margin:10px auto;
  background-color: var(--accentob);
  background-image:var(--bk);
  background-blend-mode: darken;
  background-attachment: fixed;
  background-position: center;
  background-size: cover;
  color:var(--ddd);
  border:var(--borde);
  line-height:1.4rem;
  padding:50px;
  font-size:0.95rem;
  font-family:arial, sans-serif;
  text-align:justify;
  box-sizing: content-box;
  }
  .inblood-body {
  background: rgba(var(--negrorgb),0.75);
  border:var(--borde);
  }
  .inblood-tit {
  padding: 25px;
  border-bottom: var(--borde);
  }
  .inblood-tit span.ib-tit {
  font-family: var(--letrab);
  font-weight: 700;
  font-size: 1.25rem;
  display: block;
  text-align: center;
  padding: 0px 10px 5px;
  }
  .inblood-tit span.ib-dts {
  font-family: var(--letra);
  text-transform: uppercase;
  font-size: 0.6rem;
  text-align: center;
  font-weight: 500;
  letter-spacing: 1px;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 5px;
  line-height: 13px;
  }
  .inblood-tit span.ib-dts > i{
  color:var(--accentoa);
  font-size: 1rem;
  flex:none;
  }
  .inblood-tit.dos {
  padding: 0;
  position:relative;
  height: 130px;
  display: flex;
  justify-content: end;
  align-items: center;
  }
  .inblood-tit.dos .ib-img {
  position: absolute;
  height: 130px;
  width: 275px;
  left:0;
  }
  .inblood-titd {
  position: relative;
  text-align: right;
  padding: 10px;
  text-shadow: -1px 1px var(--accentob);
  }
  .inblood-titd span.ib-tit,.inblood-titd  span.ib-dts {
  text-align: right;
  justify-content: end;
  }
  .inblood-txt {
  padding: 35px;
  }
  .inblood-txt span.in-cap {
  display: flex;
  align-items: center;
  justify-content:center;
  position: relative;
  padding: 0 10px;
  font-family: var(--letrab);
  font-size: 0.7rem;
  font-weight: 600;
  text-transform:uppercase;
  letter-spacing:1px;
  }
  .inblood-txt span.in-cap:after {
  content: "";
  width: 295px;
  background: var(--accentob);
  height: 1px;
  margin: 5px;
  }
  .inblood-pj {
  display: flex;
  position: relative;
  align-items: center;
  justify-content: start;
  border-top: var(--borde);
  height: 185px;
  }
  .inblood-pj:nth-child(odd){
  justify-content: end;
  }
  .inblood-img, .ib-img {
  width: 300px;
  height: 185px;
  position:relative;
  }
  .inblood-img {
  position: absolute;
  right: 0;
  top: 0;
  }
  .inblood-pj:nth-child(odd) .inblood-img{
  right: auto;
  left: 0;
  }
  .ib-img:before, .ib-img:after {
  content: "";
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  position: absolute;
  }
  .ib-img:before {
  background: white;
  mix-blend-mode: color;
  }
  .ib-img:after {
  background: var(--accentob);
  mix-blend-mode: multiply;
  }
  .inblood-info {
  position: relative;
  width: 215px;
  padding: 10px 0px 10px 75px;
  max-height: 165px;
  }
  .inblood-pj:nth-child(odd) .inblood-info{
  padding: 10px 75px 10px 0px;
  }
  .inblood-pj:nth-child(odd) .inblood-info > span{
  text-align:right;
  }
  .inblood-info > span{
  display:block;
  font-family: var(--letra);
  text-transform: uppercase;
  font-size: 0.6rem;
  line-height:1.1rem;
  font-weight: 500;
  letter-spacing: 1px;
  text-shadow: 1px 1px var(--accentob);
  text-align:left;
  }
  .inblood-info > span.nom{
  font-family: var(--letrab);
  font-size: 1.1rem;
  font-weight: 600;
  line-height: 1.6rem;
  position:relative;
  }
  .inblood-info > span.nom:after {
  content: "";
  border-bottom: var(--borde);
  bottom: 2px;
  position: absolute;
  left: -5px;
  width: 10%;
  }
  .inblood-pj:nth-child(odd) .inblood-info > span.nom:after{
  left: auto;
  right:-5px;
  }
/*SIMPLE*/
.simple{
  --blancorgb:255,255,255;
  --negrorgb:0,0,0;
  --blanco:#fafafa;
  --ddd:#ddd;
  --222:#222;
  --accentoa: #3e5975;
  --accentob: #6f8cab;
  --letra: "Roboto";
  --letrab: "New Amsterdam";
  --borde:1px solid var(--ddd);
  --grad:linear-gradient(90deg,var(--accentoa), var(--accentob));
  --shws:1px 1px 2px rgba(var(--negrorgb), 0.1), -1px -1px 2px rgba(var(--negrorgb), 0.1), -1px 1px 2px rgba(var(--negrorgb), 0.1), 1px -1px 2px rgba(var(--negrorgb), 0.1);
  --shwsb:1px 1px 1px rgba(var(--negrorgb), 0.1), -1px -1px 1px rgba(var(--negrorgb), 0.1), -1px 1px 1px rgba(var(--negrorgb), 0.1), 1px -1px 1px rgba(var(--negrorgb), 0.1);
  }
  .simple {
  width: 475px;
  margin:10px auto;
  background: var(--blanco);
  color:var(--222);
  border:var(--borde);
  outline:var(--borde);
  outline-offset:-12px;
  padding:12px;
  line-height:1.2rem;
  font-size:13px;
  font-family:arial, sans-serif;
  text-align:justify;
  box-sizing: content-box;
  }
  .simple-tit {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align:center;
  padding: 25px;
  font-family: var(--letrab);
  font-size: 33px;
  line-height: 33px;
  border-bottom:var(--borde);
  }
  .simple-tit.dos {
  padding: 0;
  }
  .simple-tit span > em {
  color: var(--accentob);
  font-size: 18px;
  display: block;
  line-height: 18px;
  letter-spacing: 3px;
  }
  .simple-dts, .simple-cap {
  position: relative;
  border-bottom: var(--borde);
  padding: 10px;
  text-align: center;
  font-family: var(--letra);
  text-transform:uppercase;
  font-size:10px;
  letter-spacing:1px;
  }
  .simple-cap{
  border-top:var(--borde);
  border-bottom:none;
  }
  .simple-dts:before, .simple-img:before, .simple-cap:before {
  content: "";
  position: absolute;
  top: -1px;
  bottom: -1px;
  left: -1px;
  right: -1px;
  background: var(--accentob);
  mix-blend-mode: multiply;
  opacity: 0.5;
  }
  .simple-dts > i, .sm-tit > span.simple-dtt > i{
  color: var(--accentoa);
  }
  .sm-tit {
  display: block;
  width: 329px;
  padding: 10px;
  }
  .sm-tit > span {
  font-size: 28px;
  line-height: 28px;
  }
  .sm-tit > span.simple-dtt{
  display:block;
  text-align: center;
  font-family: var(--letra);
  text-transform: uppercase;
  font-size: 10px;
  letter-spacing: 1px;
  font-weight:500;
  line-height: 15px;
  }
  .simple-txt {
  padding: 25px 50px;
  }
  .simple-pj{
  display: flex;
  align-items: center;
  position: relative;
  border-top:var(--borde);
  }
  .simple-pj:nth-child(odd) {
  flex-direction: row-reverse;
  }
  .simple-img, .sim-img {
  width: 150px;
  height: 150px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  }
  .simple-img {
  width: 125px;
  height: 125px;
  border-right: var(--borde);
  flex: none;
  }
  .simple-pj:nth-child(odd) .simple-img{
  border-right: none;
  border-left: var(--borde);
  }
  .sim-img {
  width: 90px;
  height: 90px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  border:5px solid var(--blanco);
  outline:var(--borde);
  }
  .simple-info {
  padding: 10px 15px;
  width: 319px;
  display: flex;
  flex-wrap:wrap;
  align-content: center;
  justify-content: center;
  }
  .simple-pj:nth-child(odd) .simple-info > span{
  text-align:right;
  }
  .simple-info > span {
  display: block;
  width: 100%;
  text-transform:uppercase;
  font-family: var(--letra);
  color:var(--accentoa);
  font-weight:500;
  }
  .simple-info > span.nom {
  font-family: var(--letrab);
  font-size: 33px;
  line-height: 33px;
  padding:0 10px;
  color:var(--222);
  }
  .simple-info > span > i{
  color:var(--accentob);
  }

/*Wishlist harley*/
.harley{
  --blancorgb:255,255,255;
  --blanco:#fafafa;
  --eee:#eee;
  --ddd:#ddd;
  --444:#444;
  --accentoa: #874da2;
  --accentob: #c43a30;
  --letra: "Roboto", sans-serif;
  --letrab: "Matemasie", sans-serif;
  --grad:linear-gradient(90deg,var(--accentoa), var(--accentob));
  }
  .harley {
  width: 700px;
  height: 655px;
  margin:10px auto;
  background: var(--blanco);
  color:var(--444);
  line-height:1.2rem;
  font-size:13px;
  font-family:arial, sans-serif;
  text-align:justify;
  display: flex;
  flex-wrap: wrap;
  overflow:hidden;
  position:relative;
  }
  .harley-top {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 135px;
  width: 100%;
  padding: 10px;
  }
  .harley-nom {
  margin-bottom: -20px;
  width: 255px;
  height: 165px;
  font-size: 55px;
  line-height: 36px;
  font-family: var(--letrab);
  text-align: right;
  color: var(--accentob);
  text-shadow: -2px -2px 0 var(--blanco), 3px 3px 0 var(--blanco);
  justify-content: end;
  position:relative;
  z-index:3;
  display: flex;
  align-items: flex-end;
  }
  .harley-nom:before {
  border-radius: 100%;
  content: "";
  width: 40px;
  height: 40px;
  position: absolute;
  background: var(--grad);
  top: 30px;
  left: 50px;
  rotate: 10deg;
  z-index: 1;
  border: 4px solid var(--blanco);
  }
  .harley-nom:after {
  border-radius: 100%;
  content: "";
  width: 100px;
  height: 100px;
  position: absolute;
  background: var(--grad);
  top: -25px;
  left: -25px;
  }
  .harley-nom span.h-nom {
  position:relative;
  z-index:3;
  }
  .harley-nom span.h-nom > span {
  -webkit-text-stroke: 1px var(--accentoa);
  text-transform: uppercase;
  font-weight: 900;
  color: transparent;
  font-size:45px;
  }
  .harley-dts {
  display: flex;
  align-content: center;
  justify-content: flex-end;
  width: 275px;
  flex-wrap: wrap;
  padding: 9px 5px;
  border-right: 10px solid var(--accentob);
  background: var(--blanco);
  position: relative;
  margin: 10px;
  height: fit-content;
  gap:5px;
  }
  .harley-dts.bots {
  border-right: none;
  border-left: 10px solid var(--accentoa);
  width: 170px;
  }
  .harley-dts > span {
  border-bottom: var(--ddd) 3px solid;
  padding: 1px 3px;
  flex: auto;
  text-align: center;
  font-family: var(--letra);
  font-weight: 500;
  text-transform: uppercase;
  font-size: 10px;
  }
  .harley-dts.bots > span {
  width:100%;
  display:flex;
  justify-content:space-between;
  }
  .harley-dts.bots > span > span {
  color:var(--accentoa);
  font-weight:800;
  }
  .harley-dts.bots > span:nth-of-type(odd) > span {
  color:var(--accentob);
  }
  .harley-bot {
  display: flex;
  gap: 10px;
  }
  .h-lf {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  align-content: center;
  gap: 10px;
  width: 235px;
  margin-left: 10px;
  }
  .harley-timg, .harley-timg img {
  width: 125px;
  height: 125px;
  overflow: hidden;
  border-radius: 100%;
  background: var(--grad);
  }
  .harley-timg {
  padding: 10px;
  }
  .harley-timg img {
  border: 5px solid var(--blanco);
  width: 115px;
  height: 115px;
  object-fit: cover;
  }
  .harley-trams {
  padding: 30px;
  background-color: var(--accentb);
  background: var(--grad);
  background-size: cover;
  width: 365px;
  height: 415px;
  margin-top: -20px;
  position:relative;
  overflow:auto;
  }
  .harley-int {
  padding: 10px;
  background: var(--blanco);
  position:relative;
  margin: 5px auto;
  }
  .harley-int > span {
  font-weight:800;
  color:var(--accentob);
  }
  .harley-int span.h {
  font-family: var(--letrab);
  -webkit-background-clip: text!important;
  -webkit-text-fill-color: transparent!important;
  background: -webkit-linear-gradient(0deg,var(--accentob), var(--accentoa));
  font-size: 30px;
  line-height: 32px;
  font-style: italic;
  display:block;
  }
  .harley-int span.sub {
  font-family: var(--letra);
  margin: 5px 5px 0;
  -webkit-text-stroke: 1.5px var(--accentoa);
  font-weight: 900;
  color: transparent;
  text-transform: uppercase;
  font-size: 18px;
  display: block;
  }
  .harley strong{
  color: var(--accentoa);
  }
  .harley strike,.harley i, .harley em{color:var(--accentob);font:500 1em var(--letra);}
  .harley u, .harley a{color:var(--accentoa);font:500 1em var(--letra);}
  .harley i, .harley em{font-style: italic;}
  .harley a{-webkit-background-clip: text!important;-webkit-text-fill-color: transparent!important;background: -webkit-linear-gradient(40deg,var(--accentob), var(--accentoa));background-size: 100%;font-weight: 800;transition: .7s ease-in-out;}
  .harley-int b{text-transform:uppercase;background:linear-gradient(40deg,var(--accentob), var(--accentoa));background-size: 100%;color:var(--blanco);padding:2px 7px;font-size:11px;transition: .7s ease-in-out;border-radius: var(--radius);}
  .harley a:hover{background-size: 500%;transition: .7s ease-in-out;}
/*Wishlist poison ivy*/
.poison{
  --blancorgb:255,255,255;
  --blanco:#fafafa;
  --eee:#f7f7f7;
  --ddd:#ddd;
  --444:#444;
  --accentoa: #0ba360;
  --accentob: #3cba92;
  --letra: "Roboto", sans-serif;
  --letrab: "New Amsterdam", sans-serif;
  --grad:linear-gradient(90deg,var(--accentoa), var(--accentob));
  }
  .poison {
  width: 700px;
  height: 650px;
  margin:10px auto;
  background: var(--blanco);
  border:1px solid var(--ddd);
  color:var(--444);
  line-height:1.2rem;
  font-size:13px;
  font-family:arial, sans-serif;
  text-align:justify;
