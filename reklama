/*strangerthings*/
.dptab {
width: 600px;
display: flex;
flex-flow: wrap;
align-items: center;
justify-content: center;
margin:15px auto;
position:relative;
overflow:hidden;
--radius:10px;
--rgbnegro:0,0,0;
--blanco:#fafafa;
--negro:#111;
--texto:#444;
--letra: "Bitter", sans-serif;
--letrab: "Nunito Sans", sans-serif;
--accentoa: #875833;
--accentob: #382327;
}
.dptab-cab {
width: 100%;
padding-top: 25px;
display: flex;
align-items: center;
align-content: center;
justify-content: center;
flex-flow: wrap;
position:relative;
}
.dptab-cab:before, .dptab-pj:before {
content:"";
width: 150px;
height: 400px;
background: linear-gradient(0deg, var(--accentob), var(--accentoa));
position:absolute;
left:0;
top:0;
border-radius: var(--radius);
}
.dptab-pj:before {
background: linear-gradient(90deg, var(--accentob), var(--accentoa));
width: 225px;
height: 135px;
}
.dptab-img, .dptab-img img{
width: 285px;
height: 175px;
object-fit: cover;
}
.dptab-pji, .dptab-pji img{
width: 115px;
height: 115px;
object-fit: cover;
}
.dptab-img, .dptab-pji {
overflow: hidden;
border-radius: var(--radius);
z-index: 1;
position: relative;
box-shadow: 0px 0px 8px rgba(var(--rgbnegro),0.5);
}
.dptab-cab > span, .dptab-pjt span.nombre {
font-family: var(--letra);
font-weight: 900;
font-size: 32px;
text-align: right;
z-index: 1;
position: relative;
color:var(--negro);
-webkit-background-clip: text!important;
-webkit-text-fill-color: transparent!important;
background: -webkit-linear-gradient(0deg, var(--accentob), var(--accentoa));
box-shadow:none;
line-height: 35px;
word-break: break-word;
}
.dptab-cab > span {
width: 255px;
height: 155px;
margin: 10px 0 10px 15px;
display: flex;
align-items: flex-end;
align-content: flex-end;
flex-flow: wrap;
text-transform: uppercase;
text-align: right;
}
span.gifs {
background: url(https://64.media.tumblr.com/fa176e6c5f164ba0260aa4e42baf57e3/ebafe0b8306d5c69-47/s540x810/8bdbcbd5c0a38817a93a1522cd962fa77ff9d5d7.gif);
-webkit-background-clip: text!important;
-webkit-text-fill-color: transparent!important;
}
.dptab-pjt span.nombre {
width: 100%;
text-align: left;
padding: 0 15px;
margin: 5px 0;
}
.dptab-dat, .dptab-pjs {
width: 100%;
display: flex;
padding:15px;
flex-flow: wrap;
}
.dptab-dat > span, .dptab-pjt > span, .dptab-info > span {
background: var(--negro);
margin: 3px 5px;
padding: 7px 8px;
color: var(--blanco);
font-family: var(--letrab);
font-size: 9px;
text-transform: uppercase;
flex: auto;
z-index: 1;
position: relative;
text-align:center;
font-weight: 600;
letter-spacing: 1px;
box-shadow: 0px 0px 5px rgba(var(--rgbnegro),0.5);
border-radius: var(--radius);
line-height: 20px;
}
.dptab-info span.pri{
background: linear-gradient(90deg, var(--accentob), var(--accentoa));
flex: 1;
}
.dptab-dat{
padding:20px 15px 5px;
}
.dptab-txt {
margin: 15px 20px;
padding: 25px;
background: var(--blanco);
border-radius: var(--radius);
font-family: arial, sans-serif;
font-size: 13px;
line-height: 1.45em;
text-align: justify;
color: var(--texto);
box-shadow: 0px 0px 5px rgba(var(--rgbnegro),0.5);
z-index: 1;
position: relative;
}
.dptab-pj {
display: flex;
width: 540px;
justify-content: space-between;
padding: 10px;
position: relative;
margin: 0 auto 10px;
}
.dptab-pjt{
display: flex;
flex-flow: wrap;
width: calc(100% - 130px);
justify-content: flex-end;
align-items: center;
align-content: center;
}
.dptab-pj:nth-child(2n) {
flex-direction: row-reverse;
}
.dptab-pj:nth-child(2n):before {
left:auto;
right:0;
background: linear-gradient(270deg, var(--accentob), var(--accentoa));
}
.dptab-pj:nth-child(2n) .dptab-pjt span.nombre {
text-align: right;
background: -webkit-linear-gradient(180deg, var(--accentob), var(--accentoa));
}
.dptab-info {
display: flex;
width: 100%;
margin: 0 15px;
}
